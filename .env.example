# ============================================================
# 环境变量配置说明
#
# 安全策略: 密钥只存储在系统环境变量中，不写入任何文件
#
# 请通过系统命令设置（不要在此文件中写密钥）:
#
#   Windows PowerShell:
#     [Environment]::SetEnvironmentVariable('DEEPSEEK_API_KEY', 'sk-xxx', 'User')
#
#   Windows CMD:
#     setx DEEPSEEK_API_KEY "sk-xxx"
#
#   Linux / Mac:
#     export DEEPSEEK_API_KEY="sk-xxx"
# ============================================================

# 后端地址 (前端使用)
API_BASE=http://localhost:8000

# 九天平台 AppCode (默认 provider 已切到 jiutian)
# JIUTIAN_APP_CODE=

# 可选: 其他 LLM Provider
# OPENAI_API_KEY=
# QWEN_API_KEY=
